page {
  background: #e7f3fb url("/assets/sky.jpg") center top / cover no-repeat;
  color: #16324a;
  font-size: 28rpx;
  box-sizing: border-box;
}
.pad { padding: 28rpx 28rpx 160rpx; }
.h1 { font-size: 44rpx; margin: 12rpx 0; color: #16324a; }
.muted { color: #5c7388; line-height: 1.6; }
.en { color: #8d6424; font-size: 22rpx; letter-spacing: 2rpx; }
.btn { background: #1d5fbf; color: #f5f9ff; border-radius: 16rpx; margin-top: 20rpx; }
.card { border: 1rpx solid #c5d7e8; background: rgba(248, 251, 254, 0.92); border-radius: 16rpx; padding: 20rpx; margin-top: 16rpx; }
input, textarea { background: #f8fbfe; color: #16324a; border: 1rpx solid #c5d7e8; border-radius: 12rpx; padding: 16rpx; width: 100%; box-sizing: border-box; }
.nav { position: fixed; left: 0; right: 0; bottom: 0; display: flex; background: rgba(248, 251, 254, 0.94); border-top: 1rpx solid #c5d7e8; }
.nav navigator { flex: 1; text-align: center; padding: 18rpx 0 28rpx; color: #5c7388; font-size: 22rpx; }
.nav .on { color: #1d5fbf; }
.row { display: flex; gap: 12rpx; }
.grow { flex: 1; }
.law { box-shadow: inset 6rpx 0 0 #1d5fbf; }
.biz { box-shadow: inset 6rpx 0 0 #8d6424; }
.mark { position: fixed; right: 16rpx; bottom: 120rpx; width: 96rpx; height: 96rpx; opacity: 0.55; z-index: 5; pointer-events: none; }
.hotbg { background: url("/assets/pro.jpg") center top / cover no-repeat; }
.cover { position: fixed; inset: 0; z-index: 30; }
.cover-img { width: 100%; height: 100%; }
.enter { position: absolute; left: 0; right: 0; bottom: 80rpx; margin: 0 auto; width: 220rpx; text-align: center; background: rgba(248,251,254,.92); color: #16324a; border-radius: 999rpx; padding: 16rpx 0; }
.hero { width: 100%; height: 280rpx; border-radius: 24rpx; }
.ghost { background: #f8fbfe; color: #16324a; border: 1rpx solid #c5d7e8; }